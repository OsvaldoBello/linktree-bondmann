{
  "name": "linktree-bondmann",
  "version": "0.1.0",
  "private": true,
  "description": "Agregador de links operacionais da Bondmann Química, organizado por setor.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate:links": "node scripts/validate-links.ts",
    "bench": "node scripts/bench.mjs",
    "doc:sync": "node scripts/sync-master-doc.mjs",
    "doc:check": "node scripts/sync-master-doc.mjs --check",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run validate:links && npm run test:unit -- --coverage && npm run build"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@size-limit/file": "13.0.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-security": "4.2.0",
    "jsdom": "30.1.3",
    "playwright-core": "1.64.1",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "size-limit": "13.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "4.1.10",
    "zod": "4.6.7"
  },
  "overrides": {
    "postcss": "8.5.31",
    "sharp": "0.35.5",
    "nanoid": "3.3.19",
    "source-map-js": "1.2.2"
  }
}
